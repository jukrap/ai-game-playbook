{
  "name": "ai-game-playbook",
  "version": "0.0.0",
  "private": true,
  "description": "Safety-bounded AI game development control plane for Godot, Unity, and Unreal Engine.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": ">=11.4.0 <12"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "ci:check-clean": "node scripts/check-worktree-clean.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:test": "node scripts/check-docs.test.mjs",
    "plan:check": "node scripts/generate-foundation-plan.mjs --check",
    "plan:write": "node scripts/generate-foundation-plan.mjs --write",
    "test": "node --test \"test/*.test.mjs\" \"packages/*/test/*.test.mjs\"",
    "typecheck": "tsc -b --pretty false",
    "verify": "pnpm run typecheck && pnpm run plan:check && pnpm run test && pnpm run docs:test && pnpm run docs:check"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}
